<odoo>
  <record id="rule_family_admin_partner" model="ir.rule">
    <field name="name">Partners de la meua família</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="groups" eval="[(4, ref('familia.group_family_admin'))]"/>
    <field name="domain_force">
      [('id', 'in', user.partner_id.familia_miembros_ids.mapped('familia_id.miembros_ids.partner_id.id'))]
    </field>
  </record>
</odoo>
