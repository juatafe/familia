<odoo>
    <!-- 🔹 Categoria pròpia "Familia" -->
    <record id="module_category_familia" model="ir.module.category">
        <field name="name">Familia</field>
        <field name="description">Permisos i rols específics de la gestió de famílies</field>
        <field name="sequence">30</field>
    </record>

    <!-- 🔹 Grup Manager de Família (acés complet a models familia i familia.miembro) -->
    <record id="group_familia_manager" model="res.groups">
        <field name="name">Familia Manager</field>
        <field name="category_id" ref="familia.module_category_familia"/>
    </record>

    <!-- 🔹 Regles d'accés a familia -->
    <record id="familia_familia_rule" model="ir.rule">
        <field name="name">Familia: veure totes</field>
        <field name="model_id" ref="familia.model_familia_familia"/>
        <field name="groups" eval="[(4, ref('familia.group_familia_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- 🔹 Regles d'accés a familia.miembro -->
    <record id="familia_miembro_rule" model="ir.rule">
        <field name="name">Membre de Família: veure tots</field>
        <field name="model_id" ref="familia.model_familia_miembro"/>
        <field name="groups" eval="[(4, ref('familia.group_familia_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- 🔹 Grup Administrador de Família (pels usuaris finals admins de la seua família) -->
    <record id="group_family_admin" model="res.groups">
        <field name="name">Administrador de Família</field>
        <field name="category_id" ref="familia.module_category_familia"/>
    </record>
</odoo>
