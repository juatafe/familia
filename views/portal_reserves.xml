<odoo>
  <data>

    <!-- /my/orders -->
    <template id="portal_my_orders_inherit_reserves"
              inherit_id="sale.portal_my_orders"
              name="Orders headers → Comanda"
              priority="20">
      <xpath expr="//th[1]" position="replace">
        <th>Comanda #</th>
      </xpath>
      <xpath expr="//th[2]" position="replace">
        <th class="text-center">Data de comanda</th>
      </xpath>
    </template>

    <!-- /my/quotes -->
    <template id="portal_my_quotations_inherit_reserves"
              inherit_id="sale.portal_my_quotations"
              name="Quotations headers → Reserva"
              priority="20">
      <xpath expr="//th[1]" position="replace">
        <th>Reserva #</th>
      </xpath>
      <xpath expr="//th[2]" position="replace">
        <th class="text-center">Data de reserva</th>
      </xpath>
    </template>

