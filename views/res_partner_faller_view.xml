<odoo>
    <record id="view_res_partner_faller_form" model="ir.ui.view">
        <field name="name">res.partner.faller.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Inserta una nova pestanya després de 'internal_notes' -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Informació Fallera">
                    <group>
                        <field name="codifaller" string="Codi"/>
                        <field name="vat"/>
                        <field name="data_naixement" string="Data de Naixement"/>
                        <field name="sexe" string="Sexe"/>
                        <field name="phone"/>
                        <field name="mobile"/>
                        <field name="email"/>
                        <field name="provincia" string="Província"/>
                        <field name="codi_postal_personalitzat"/>
                    </group>
                    <group string="Alta i Família">
                        <field name="alta"/>
                        <field name="data_alta" string="Data d'alta"/>
                        <field name="data_baixa" string="Data de baixa"/>
                        <field name="numero_familia" string="Identificador de família"/>
                    </group>
                    <group string="Càrrecs">
                        <field name="es_regina_major"/>
                        <field name="fallera_major_infantil"/>
                        <field name="regina_infantil"/>
                        <field name="regina_o_major"/>
                        <field name="regina_o_infantil"/>
                    </group>
                    <group string="Historial">
                        <field name="antiguitat_previa" string="Antiguitat prèvia"/>
                        <field name="n_comissions" string="Nombre de comissions"/>
                        <field name="baremacio" string="S'ha baremat?"/>
                        <field name="comentari" string="Altres dades o comentaris"/>
                    </group>
                </page>
            </xpath>

            <!-- Substituir el camp 'function' per eliminar-lo del formulari -->
            <xpath expr="//field[@name='function']" position="replace"/>
            <xpath expr="//field[@name='website']" position="replace"/>
            <xpath expr="//field[@name='title']" position="attributes">
                 <attribute name="domain">[('name', 'in', ['En', 'Na', "N'"])]</attribute>
            </xpath>

        </field>
    </record>
</odoo>
